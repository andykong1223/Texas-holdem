# 复制为 .env 后修改
# cp .env.example .env

# 对外映射端口
HOST_PORT=3000

# JWT 密钥（生产环境务必改成随机长字符串）
JWT_SECRET=please-change-me-to-a-long-random-string

# Token 有效期
JWT_EXPIRES=7d

# 数据目录（相对部署目录或绝对路径）
DATA_DIR=./data

# 镜像名
IMAGE_NAME=texas-holdem-h5:latest

# 构建基础镜像（海外可改为 node:22-alpine）
# NODE_IMAGE=node:22-alpine
NODE_IMAGE=m.daocloud.io/docker.io/library/node:22-alpine
